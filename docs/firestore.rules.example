// User-approved no-auth model for the UTS demo.
// These Rules allow public CRUD without Authentication. songs and users validate
// their core fields and the app's album/playlist documents are validated.
// Any client can use the public collections; these Rules do not identify or
// isolate users.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validSong(data) {
      return data.keys().hasAll([
          'title', 'creator', 'type', 'sourceType', 'mediaUrl',
          'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.creator is string
        && data.creator.size() > 0
        && data.creator.size() <= 120
        && data.type in ['audio', 'video']
        && (!data.keys().hasAny(['description'])
          || (data.description is string && data.description.size() <= 1000))
        && (!data.keys().hasAny(['category'])
          || (data.category is string && data.category.size() <= 80))
        && data.sourceType in ['network', 'youtube', 'asset']
        && data.mediaUrl is string
        && data.mediaUrl.size() > 0
        && (!data.keys().hasAny(['thumbnailUrl'])
          || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (data.sourceType == 'network' && data.mediaUrl.matches('^https://.*$'))
          || (data.sourceType == 'youtube'
            && data.type == 'video'
            && data.mediaUrl.matches('^https://((www\\.|m\\.)?youtube\\.com|youtu\\.be)/.*$'))
          || (data.sourceType == 'asset' && data.mediaUrl.matches('^assets/.+$'))
        );
    }

    function validCollection(data) {
      return data.keys().hasAll([
          'name', 'description', 'trackIds', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 1000
        && data.trackIds is list
        && data.trackIds.size() <= 500
        && data.trackIds.toSet().size() == data.trackIds.size()
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validUserRecord(data) {
      return data.keys().hasAll([
          'nama', 'email', 'kelas', 'createdAt', 'updatedAt'
        ])
        && data.nama is string
        && data.nama.size() > 0
        && data.nama.size() <= 120
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.kelas is string
        && data.kelas.size() > 0
        && data.kelas.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /songs/{songId} {
      allow read, delete: if true;
      allow create: if validSong(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validSong(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userRecordId} {
      allow read, delete: if true;
      allow create: if validUserRecord(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validUserRecord(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /albums/{albumId} {
      allow read, delete: if true;
      allow create: if validCollection(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validCollection(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /playlist/{playlistId} {
      allow read, delete: if true;
      allow create: if validCollection(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if validCollection(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }
  }
}
